#!/bin/sh
# Refuse pushes to main: changes reach main only through squash-merged pull requests.
# Enable once per clone with: git config core.hooksPath .githooks
while read -r local_ref local_sha remote_ref remote_sha; do
    if [ "$remote_ref" = "refs/heads/main" ]; then
        echo "pre-push: refusing to push to main. Push a branch and open a pull request instead." >&2
        exit 1
    fi
done
exit 0
